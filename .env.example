# Optional: a different booking page for the "Book a call" panel (Calendly or Cal.com).
# Leave empty to use the Calendly link in src/config.ts.
VITE_BOOKING_URL=

# Optional: Umami website ID for anonymous visit stats (cloud.umami.is → Add website).
# Leave empty for no tracking. Only production builds load the tracker.
VITE_UMAMI_ID=
